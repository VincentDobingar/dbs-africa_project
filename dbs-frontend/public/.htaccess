# Fallback all unmatched routes to index.html so React Router can
# handle client-side navigation (SPA), instead of Apache 404ing on
# direct visits/refreshes to routes like /about or /equipe/:slug.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
